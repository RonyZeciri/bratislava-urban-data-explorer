# Dokumentacny priklad. Backend tento subor automaticky nenacitava.
# Nastav hodnoty v PowerShell $env: alebo v konfiguracii hostingu.
APP_ENV=development
CORS_ALLOWED_ORIGINS=[]
SNAPSHOT_API_ENABLED=true
# Bezpecna produkcia: APP_ENV=production, SNAPSHOT_API_ENABLED=false
# CORS_ALLOWED_ORIGINS=["https://frontend.example.com"]
